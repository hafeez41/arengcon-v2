{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arengcon-v2",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "arengcon" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arengcon",
      "database_id": "30a2519c-c28c-4809-9283-71f6800df235"
    }
  ],
  "observability": {
    "enabled": true
  }
}
